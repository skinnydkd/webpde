{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/economia.html", "destination": "/economia", "permanent": true },
    { "source": "/empresa.html", "destination": "/empresa", "permanent": true },
    { "source": "/finances.html", "destination": "/finances", "permanent": true },
    { "source": "/vidapractica.html", "destination": "/vidapractica", "permanent": true },
    { "source": "/ferramentes.html", "destination": "/ferramentes", "permanent": true },
    { "source": "/recerca.html", "destination": "/recerca", "permanent": true },
    { "source": "/playground.html", "destination": "/playground", "permanent": true },
    { "source": "/concurs.html", "destination": "/concurs", "permanent": true },
    { "source": "/stonks.html", "destination": "/stonks", "permanent": true },
    { "source": "/stax", "destination": "/stonks", "permanent": true },
    { "source": "/stax.html", "destination": "/stonks", "permanent": true },
    { "source": "/communist.html", "destination": "/communist", "permanent": true },
    { "source": "/econopoly.html", "destination": "/econopoly", "permanent": true },
    { "source": "/econrisk.html", "destination": "/econrisk", "permanent": true },
    { "source": "/insider.html", "destination": "/insider", "permanent": true },
    { "source": "/edmn-2bach.html", "destination": "/edmn-2bach", "permanent": true },
    { "source": "/economia-1bach.html", "destination": "/economia-1bach", "permanent": true },
    { "source": "/fopp-4eso.html", "destination": "/fopp-4eso", "permanent": true },
    { "source": "/economia-4eso.html", "destination": "/economia-4eso", "permanent": true },
    { "source": "/oposicions.html", "destination": "/oposicions", "permanent": true },
    { "source": "/oposicions-bloc-a.html", "destination": "/oposicions-bloc-a", "permanent": true },
    { "source": "/oposicions-bloc-b.html", "destination": "/oposicions-bloc-b", "permanent": true },
    { "source": "/oposicions-bloc-c.html", "destination": "/oposicions-bloc-c", "permanent": true },
    { "source": "/oposicions-bloc-d.html", "destination": "/oposicions-bloc-d", "permanent": true },
    { "source": "/oposicions-bloc-e.html", "destination": "/oposicions-bloc-e", "permanent": true },
    { "source": "/oposicions-bloc-f.html", "destination": "/oposicions-bloc-f", "permanent": true },
    { "source": "/oposicions-bloc-g.html", "destination": "/oposicions-bloc-g", "permanent": true },
    { "source": "/oposicions-bloc-h.html", "destination": "/oposicions-bloc-h", "permanent": true },
    { "source": "/oposicions-practica.html", "destination": "/oposicions-practica", "permanent": true },
    { "source": "/professorat.html", "destination": "/professorat", "permanent": true }
  ]
}
